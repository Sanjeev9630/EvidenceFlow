# Copy to repo root as .env and fill DATABASE_URL from Neon.
# This file is a convenience if you prefer env next to the API.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
PORT=3001
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
DEMO_MODE=true
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
