# Neon Postgres connection string (use the pooled URL for the app)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# API
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
DEMO_MODE=true

# LLM — used from Day 5 (PDF extraction). Optional on Day 1.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai
LLM_TIMEOUT_MS=25000

# Web (Vite)
VITE_API_URL=http://localhost:3001

# --- Hosted deploy (Day 7+) ---
# After API is live (Railway/Render), set GitHub repo secret:
#   KEEP_ALIVE_URL = https://YOUR-API-HOST/health
# That URL is pinged by .github/workflows/keep-alive.yml every ~10 minutes
# so free-tier hosts do not sleep. Do NOT put this secret in .env —
# it only lives in GitHub → Settings → Secrets and variables → Actions.
